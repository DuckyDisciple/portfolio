---
const home = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL;
const logoSrc = `${import.meta.env.BASE_URL}LogoHorizontal.svg`;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={home}>
      <img
        class="site-header__logo"
        src={logoSrc}
        alt="Drew Sartorius"
        width="336"
        height="111"
        decoding="async"
      />
    </a>
    <span class="site-header__tag">web developer</span>
  </div>
</header>
